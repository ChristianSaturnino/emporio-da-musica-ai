# Copy this file to .env and fill in your own values. Never commit .env.

# Required only to talk to the real model. Automated tests do not use it.
OPENAI_API_KEY=

# An OpenAI chat model that supports JSON output. See evals/RESULTS.md for why this one.
OPENAI_MODEL=gpt-6-luna

# Only used by models that accept it, such as the one above. "none" is the fastest. gpt-6-luna
# rejects "minimal", which would make every message fail.
OPENAI_REASONING_EFFORT=none

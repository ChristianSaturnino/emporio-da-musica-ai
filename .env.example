# Copy this file to .env and fill in your own values. Never commit .env.

# Required only to talk to the real model. Automated tests do not use it.
OPENAI_API_KEY=

# An OpenAI chat model that supports structured outputs. See evals/RESULTS.md for why this one.
OPENAI_MODEL=gpt-6-luna

# Only used by models that accept it, such as the one above.
OPENAI_REASONING_EFFORT=low
